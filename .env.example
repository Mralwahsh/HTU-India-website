# Copy this file to .env.local (git-ignored) and fill in the values. Never commit real keys.
# On Vercel, add the same three variables under Project → Settings → Environment Variables.

# Supabase project → Project Settings → API (or "Connect"): the Project URL and the anon / publishable key.
# The anon key is meant to be public (it ships in the page); the database is protected by row-level security.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Maps browser key for the Street View tours (Maps JavaScript API only).
# Restrict it by HTTP referrer in Google Cloud Console (see "Offline photos or Google Street View" in BOOTH_SETUP.md).
VITE_GOOGLE_MAPS_API_KEY=
